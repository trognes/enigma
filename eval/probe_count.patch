+/* PROBE COUNT INSTRUMENTATION (eval/probe_count.patch, not for merging).
+   [stage][cat]: stage 0 = histogram pre-pass, 1 = target model.
+   cat 0 = -J ordering scan, 1 = sweep probes up to the last accepted move,
+   2 = sweep probes after it (the confirming tail), 3 = try_repair,
+   4 = steepest passes that improved, 5 = steepest final pass,
+   6 = -K IC-ordering moves (O(26), not a decode). */
+long g_pc[2][7];
+long g_pc_sweeps[2];
+long g_pc_accept[2];
+long g_pc_repair_hit[2];
+/* stale run (consecutive non-improving moves) at the moment of acceptance */
+static const int pc_gap_edge[] = { 10, 25, 50, 100, 150, 200, 250, 300, 326 };
+long g_pc_gap[2][9];
+void probe_count_report();
+void probe_count_report()
+{
+  static const char * const nm[7] = { "order scan", "sweep live", "sweep tail",
+                                      "try_repair", "steep live", "steep tail",
+                                      "IC order" };
+  for (int st = 0; st < 2; st++)
+    {
+      long tot = 0;
+      for (int c = 0; c < 6; c++)
+        tot += g_pc[st][c];
+      fprintf(stderr, "PROBES stage=%s sweeps=%ld accepted=%ld "
+              "repair_hits=%ld total=%ld\n", st ? "target" : "prepass",
+              g_pc_sweeps[st], g_pc_accept[st], g_pc_repair_hit[st], tot);
+      for (int c = 0; c < 7; c++)
+        fprintf(stderr, "PROBES   %-11s %10ld  %5.1f%%\n", nm[c], g_pc[st][c],
+                (c < 6 && tot) ? 100.0 * g_pc[st][c] / tot : 0.0);
+      for (int k = 0; k < 9; k++)
+        fprintf(stderr, "GAP stage=%s below=%d %ld\n", st ? "target" : "prepass",
+                pc_gap_edge[k], g_pc_gap[st][k]);
+    }
+}
